<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keeps reading aloud going with the screen locked. Merged into the generated Info.plist
	     (GENERATE_INFOPLIST_FILE stays on). This key is an array, which INFOPLIST_KEY_* can't carry. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
